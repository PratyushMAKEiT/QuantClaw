<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Header (Symbol, Side, Timestamp) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tradeSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BTCUSD.P"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tradeSide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/tradeSymbol"
            android:background="@drawable/bg_badge_long"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="LONG"
            android:textColor="#10b981"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tradeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="07/04 15:43"
            android:textColor="#64748b"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Row 2: Gross P&L, Fees, India Costing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GROSS P&amp;L"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tradeGrossPnL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+$25.00"
                android:textColor="#e2e8f0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEE (GLOBAL)"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tradeFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$1.20"
                android:textColor="#e2e8f0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INDIA COST"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tradeIndiaCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$4.50"
                android:textColor="#e2e8f0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Net P&L & Net Label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#020617"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NET REALIZED P&amp;L"
            android:textColor="#94a3b8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tradeNetPnL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+$19.30"
            android:textColor="#34d399"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 4: AI Reasoning -->
    <TextView
        android:id="@+id/tradeReasoning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#64748b"
        android:textSize="10sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="No reasoning provided." />

</LinearLayout>
