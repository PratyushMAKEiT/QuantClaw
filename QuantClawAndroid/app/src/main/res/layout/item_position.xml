<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Header (Symbol, Side, Regime) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/posSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BTCUSD.P"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/posRegime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/posSymbol"
            android:background="@drawable/bg_badge_regime"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="BETA"
            android:textColor="#22d3ee"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/posBias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/posRegime"
            android:background="@drawable/bg_badge_neutral"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="BIAS: +0.00"
            android:textColor="#94a3b8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/posSide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_long"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="LONG"
            android:textColor="#10b981"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Row 2: Stats (Prices & P&L) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTRY / MARK"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/posPrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$65,420.00 / $65,580.00"
                android:textColor="#e2e8f0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNREALIZED P&amp;L"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/posPnL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+0.24% (+$12.50)"
                android:textColor="#10b981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#1e293b" />

    <!-- Row 3: Progress Tracker labels -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/posSLText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SL: $65,000.00"
            android:textColor="#f87171"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/posTPText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="TP: $66,000.00"
            android:textColor="#34d399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ProgressBar: SL to TP tracking -->
    <ProgressBar
        android:id="@+id/posProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="42"
        android:progressDrawable="@drawable/custom_progress_bar" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnPosBreakeven"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_rounded"
            android:text="BREAKEVEN"
            android:textColor="#38bdf8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnPosClose"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#ff3d57"
            android:text="CLOSE"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>
