// ==============================================================================
// OCC Strategy R5.1 - QuantClaw Edition
// Pine Script v6 — TradingView Strategy with QuantClaw Webhook Integration
// ==============================================================================
//
// Original OCC Strategy: @JayRogers (Revisions 3-5: JustUncleL)
// QuantClaw Integration: Automated webhook layer for QuantClaw desktop app
//
// This script runs YOUR exact Open-Close Crossover strategy and sends
// trade signals via TradingView webhook alerts to the QuantClaw FastAPI
// server. QuantClaw's AI engine + Risk Manager then handle execution,
// TP/SL placement, trailing stops, and position management on Delta Exchange.
//
// SETUP INSTRUCTIONS:
//   1. Paste this script into TradingView Pine Editor, Save & Add to Chart.
//   2. Open the script settings → QuantClaw Settings group:
//      - Enter your QuantClaw Webhook Token (must match the token in QuantClaw app).
//      - Set Trade Quantity in $ (this is passed to QuantClaw for sizing).
//   3. Create an Alert (Alt+A):
//      - Condition: "OCC Strategy R5.1 - QuantClaw Edition"
//      - Notifications → Check "Webhook URL"
//      - Webhook URL: Your QuantClaw server URL (e.g. https://your-ngrok.ngrok.io/webhook)
//      - Message field: {{strategy.order.alert_message}}
//   4. Save the alert. QuantClaw will now receive all trade signals.
//
// NOTE: TP/SL from the "Exit Settings" group control TradingView's internal
//       strategy exits (for backtesting). QuantClaw's Risk Manager handles
//       real TP/SL/trailing independently based on the AI-assigned regime.
//
// ==============================================================================

//@version=6
strategy(
     title             = "OCC Strategy R5.1 - QuantClaw Edition", 
     shorttitle        = "OCC R5 QC", 
     overlay           = true, 
     pyramiding        = 0, 
     default_qty_type  = strategy.percent_of_equity, 
     default_qty_value = 10, 
     calc_on_every_tick = false
     )

// Revision:        5
// Original Author: @JayRogers
// Revision Author: JustUncleL revisions 3, 4, 5
// QuantClaw Integration Layer

// ==========================================
// 1. QUANTCLAW WEBHOOK SETTINGS
// ==========================================
tradeQtyDollars = input.float(100.0,          title="Trade Quantity in $",   group="QuantClaw Settings")
webhookCode     = input.string("7JM547NDTXF76FQ5", title="QuantClaw Webhook Token", group="QuantClaw Settings",
     tooltip="Must match the Webhook Token configured in QuantClaw's Settings panel")

// ==========================================
// 2. CORE STRATEGY INPUTS
// ==========================================
useRes      = input.bool(defval = true, title = "Use Alternate Resolution?", group="Strategy Settings")
intRes      = input.int(defval = 3,    title = "Multiplier for Alternate Resolution", group="Strategy Settings")
basisType   = input.string(defval = "SMMA", title = "MA Type: ", options=["SMA", "EMA", "DEMA", "TEMA", "WMA", "VWMA", "SMMA", "HullMA", "LSMA", "ALMA", "SSMA", "TMA"], group="Strategy Settings")
basisLen    = input.int(defval = 8, title = "MA Period", minval = 1, group="Strategy Settings")
offsetSigma = input.int(defval = 6, title = "Offset for LSMA / Sigma for ALMA", minval = 0, group="Strategy Settings")
offsetALMA  = input.float(defval = 0.85, title = "Offset for ALMA", minval = 0, step = 0.01, group="Strategy Settings")
scolor      = input.bool(false, title="Show coloured Bars to indicate Trend?", group="Strategy Settings")
delayOffset = input.int(defval = 0, title = "Delay Open/Close MA (Forces Non-Repainting)", minval = 0, step = 1, group="Strategy Settings")
tradeType   = input.string("BOTH", title="What trades should be taken : ", options=["LONG", "SHORT", "BOTH", "NONE"], group="Strategy Settings")

stratRes    = timeframe.ismonthly ? str.tostring(timeframe.multiplier * intRes, "###M") : timeframe.isweekly ? str.tostring(timeframe.multiplier * intRes, "###W") : timeframe.isdaily ? str.tostring(timeframe.multiplier * intRes, "###D") : timeframe.isintraday ? str.tostring(timeframe.multiplier * intRes, "####") : '60'

// Constants colours that include fully non-transparent option.
green100   = #008000FF
lime100    = #00FF00FF
red100     = #FF0000FF
darkred100 = #8B0000FF

// === BASE FUNCTIONS ===
variant(type, src, len, offSig, offALMA) =>
    v1 = ta.sma(src, len)                                                  
    v2 = ta.ema(src, len)                                                  
    v3 = 2 * v2 - ta.ema(v2, len)                                          
    v4 = 3 * (v2 - ta.ema(v2, len)) + ta.ema(ta.ema(v2, len), len)               
    v5 = ta.wma(src, len)                                                  
    v6 = ta.vwma(src, len)                                                 
    v7 = 0.0
    v7 := na(v7[1]) ? v1 : (v7[1] * (len - 1) + src) / len    
    v8 = ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))   
    v9 = ta.linreg(src, len, offSig)                                       
    v10 = ta.alma(src, len, offALMA, offSig)                               
    v11 = ta.sma(v1, len)                                                   
    a1 = math.exp(-1.414 * 3.14159 / len)
    b1 = 2 * a1 * math.cos(1.414 * 3.14159 / len)
    c2 = b1
    c3 = (-a1) * a1
    c1 = 1 - c2 - c3
    v12 = 0.0
    v12 := c1 * (src + nz(src[1])) / 2 + c2 * nz(v12[1]) + c3 * nz(v12[2])
    type == "EMA" ? v2 : type == "DEMA" ? v3 : type == "TEMA" ? v4 : type == "WMA" ? v5 : type == "VWMA" ? v6 : type == "SMMA" ? v7 : type == "HullMA" ? v8 : type == "LSMA" ? v9 : type == "ALMA" ? v10 : type == "TMA" ? v11 : type == "SSMA" ? v12 : v1

// security wrapper for repeat calls
reso(exp, use, res) => use ? request.security(syminfo.tickerid, res, exp, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on) : exp

// === SERIES SETUP ===
closeSeries     = variant(basisType, close[delayOffset], basisLen, offsetSigma, offsetALMA)
openSeries      = variant(basisType, open[delayOffset], basisLen, offsetSigma, offsetALMA)

// Get Alternate resolution Series if selected.
closeSeriesAlt = reso(closeSeries, useRes, stratRes)
openSeriesAlt  = reso(openSeries, useRes, stratRes)

trendColour = (closeSeriesAlt > openSeriesAlt) ? color.green : color.red
bcolour     = (closeSeries > openSeriesAlt) ? lime100 : red100
barcolor(scolor ? bcolour : na, title = "Bar Colours")
closeP = plot(closeSeriesAlt, title = "Close Series", color = color.new(trendColour, 20), linewidth = 2, style = plot.style_line)
openP  = plot(openSeriesAlt, title = "Open Series", color = color.new(trendColour, 20), linewidth = 2, style = plot.style_line)
fill(closeP, openP, color = color.new(trendColour, 80))

// === ALERT CONDITIONS ===
xlong       = ta.crossover(closeSeriesAlt, openSeriesAlt)
xshort      = ta.crossunder(closeSeriesAlt, openSeriesAlt)
longCond    = xlong   
shortCond   = xshort  

// === EXTRA STRATEGY INPUTS ===
slPoints    = input.int(defval = 0, title = "Initial Stop Loss Points (zero to disable)", minval = 0, group="Exit Settings")
tpPoints    = input.int(defval = 0, title = "Initial Target Profit Points (zero for disable)", minval = 0, group="Exit Settings")
ebar        = input.int(defval = 10000, title="Number of Bars for Back Testing", minval=0, group="Exit Settings")
dummy       = input.bool(false, title="- SET to ZERO for Daily or Longer Timeframes", group="Exit Settings")

tdays       = (timenow - time) / 60000.0  
tdays      := timeframe.ismonthly ? tdays / 1440.0 / 5.0 / 4.3 / timeframe.multiplier : timeframe.isweekly ? tdays / 1440.0 / 5.0 / timeframe.multiplier : timeframe.isdaily ? tdays / 1440.0 / timeframe.multiplier : tdays / timeframe.multiplier 

TP = tpPoints > 0 ? tpPoints : na
SL = slPoints > 0 ? slPoints : na

// ==========================================
// 3. QUANTCLAW JSON MESSAGE BUILDERS
// ==========================================
//
// Builds a JSON array payload that QuantClaw's FastAPI server can parse.
// The server recognizes these keys:
//   - chart_symbol  → maps to "symbol" (ticker name)
//   - order_type    → maps to "action" (buy/sell/short/cover)
//   - price         → current close price
//   - quantity      → trade size in USD
//   - code          → webhook authentication token
//   - atr           → 14-period ATR (used by Risk Manager for regime management)
//   - rsi           → 14-period RSI (used by AI engine for regime classification)
//
// Uses simple string concatenation — NO str.format() — to avoid runtime errors.

atrValue = ta.atr(14)
rsiValue = ta.rsi(close, 14)

// Entry payload: includes ATR + RSI for QuantClaw's AI engine and Risk Manager
get_entry_json(order_type) =>
    '[\n  {\n    "exchange": "delta",\n    "price": "' + str.tostring(close) + '",\n    "chart_symbol": "' + syminfo.ticker + '",\n    "order_type": "' + order_type + '",\n    "instrument_type": "NA",\n    "quantity": "' + str.tostring(tradeQtyDollars) + '",\n    "atr": "' + str.tostring(atrValue, "#.##") + '",\n    "rsi": "' + str.tostring(rsiValue, "#.##") + '",\n    "code": "' + webhookCode + '"\n  }\n]'

// Exit payload: closes existing position — AI bypass, no ATR/RSI needed
get_exit_json(order_type) =>
    '[\n  {\n    "exchange": "delta",\n    "price": "' + str.tostring(close) + '",\n    "chart_symbol": "' + syminfo.ticker + '",\n    "order_type": "' + order_type + '",\n    "instrument_type": "NA",\n    "quantity": "' + str.tostring(tradeQtyDollars) + '",\n    "atr": "0",\n    "rsi": "0",\n    "code": "' + webhookCode + '"\n  }\n]'

buyMsg   = get_entry_json("buy")    // Opens Long
sellMsg  = get_exit_json("sell")    // Closes Long cleanly
shortMsg = get_entry_json("short")  // Opens Short
coverMsg = get_exit_json("cover")   // Closes Short cleanly

// ==========================================
// 4. EXECUTION LAYER WITH STRICT SPLIT ORDERS
// ==========================================
if ((ebar == 0 or tdays <= ebar) and tradeType != "NONE")
    
    // --- LONG ENTRY SEQUENCE ---
    if longCond and tradeType != "SHORT"
        if strategy.position_size < 0
            // Close Short first using safe cover payload
            strategy.close("short", comment="Close Short", alert_message = coverMsg)
            // alert(coverMsg, alert.freq_once_per_bar_close) // Bypassed during reversal to prevent double-signals
        
        // Open new Long
        strategy.entry("long", strategy.long, comment="Open Long", alert_message = buyMsg)
        alert(buyMsg, alert.freq_once_per_bar_close)
        
    // --- SHORT ENTRY SEQUENCE ---
    if shortCond and tradeType != "LONG"
        if strategy.position_size > 0
            // Close Long first using safe sell payload
            strategy.close("long", comment="Close Long", alert_message = sellMsg)
            // alert(sellMsg, alert.freq_once_per_bar_close) // Bypassed during reversal to prevent double-signals
            
        // Open new Short
        strategy.entry("short", strategy.short, comment="Open Short", alert_message = shortMsg)
        alert(shortMsg, alert.freq_once_per_bar_close)
        
    // --- STANDARD EXITS (For single-direction running) ---
    if shortCond and tradeType == "LONG"
        strategy.close("long", comment="Close Long", alert_message = sellMsg)
        alert(sellMsg, alert.freq_once_per_bar_close)
        
    if longCond and tradeType == "SHORT"
        strategy.close("short", comment="Close Short", alert_message = coverMsg)
        alert(coverMsg, alert.freq_once_per_bar_close)
        
    strategy.exit("XL", from_entry = "long", profit = TP, loss = SL)
    strategy.exit("XS", from_entry = "short", profit = TP, loss = SL)
